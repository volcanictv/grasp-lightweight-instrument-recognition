# Dataset -- not redistributed via git, tens of GB. GRASP_DATA_ROOT points
# here; never hardcoded in scripts (see CLAUDE.md).
GraSp/
GraSP/
GraSP_cache/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Experiment outputs: git-ignored except manifests (CLAUDE.md repo layout).
# Manifests alone fully describe a run (config, git commit, seed, checksums,
# metrics) and are cheap; checkpoints, ONNX exports, and figures are not.
# `**` (not `*`) is required to reach nested files like figures/*.png.
experiments/*/**
!experiments/*/manifest.json

# Local tooling / session state, not project source.
.claude/
.vscode/
.idea/

# Internal research notes: decision log, findings, literature notes, dataset
# report, environment notes, raw training logs, dataset-inspection figures.
# These are working documents (a lot of "tried X, didn't work" reasoning and
# GPU-cost/timeline detail) that fed the report but aren't meant to ship with
# a shared codebase -- local only, on purpose. docs/reports/ (the actual
# published report) is NOT covered by this and stays tracked.
CLAUDE.md
PROJECT_SPEC.md
docs/DECISIONS.md
docs/findings.md
docs/dataset_report.md
docs/environment.md
docs/imbalance_notes.md
docs/detection_literature_notes.md
docs/generalization_datasets.md
docs/*.log
docs/figures/
docs/samples/

# Generalization test datasets -- not redistributed via git, tens of GB.
EndoVis2017/
EndoVis2018/
SAR-RARP50/

# Generated error-gallery crops + built page (scripts/generate_error_gallery.py,
# scripts/build_error_gallery_page.py) -- reproducible output, not source.
error_gallery/

# ONNX exports from scripts/evaluate_int8_quantization.py -- reproducible
# output (240MB, fp32 + int8 per model), not source.
onnx_export/
